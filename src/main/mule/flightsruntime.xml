	<http:request-config name="HTTP_Request_config" doc:name="HTTP Request config" doc:id="77305c79-6582-4f7d-84c8-e00df43bac2c" >
		<http:request-connection host="${flights.api.host}" port="${flights.api.port}" />
	</http:request-config>
	<configuration-properties doc:name="Configuration properties" doc:id="7433759a-46cb-406e-9d42-37d765bf3c14" file="flightsruntime.properties" />
	<flow name="flightsruntimeFlow" doc:id="d52ed540-ffc8-4290-8f1c-771e96d8f7a3" >
		<http:listener doc:name="Listener" doc:id="ec2e2470-b6d5-4814-9c34-43b4f9892ed0" config-ref="HTTP_Listener_config" path="${listener.http.path}"/>
		<logger level="INFO" doc:name="Logger" doc:id="7ee68289-ea09-489e-9b05-9acb4af51b5b" message="rumtime flow started now"/>
		<http:request doc:name="Request" doc:id="3ada1575-2990-4a55-95e6-bd7728c9bf33" config-ref="HTTP_Request_config" path="${flights.api.path}"/>
		<logger level="INFO" doc:name="Logger" doc:id="fc2303f7-dc5b-4a87-a4c8-9df59147b482" message="runtime end now"/>
	</flow>
</mule>
